# ============================================
# LLM 提供商切换（改这一行即可切换）
# 可选: mxou | siliconflow | aliyun | ollama | groq
# ============================================
LLM_PROVIDER=mxou

# ============ API Keys ============
# mxou
MXOU_API_KEY=your-mxou-key-here

# 硅基流动 (siliconflow.cn)
SILICONFLOW_API_KEY=your-siliconflow-key

# 阿里云百炼 (bailian.console.aliyun.com)
ALIYUN_API_KEY=your-aliyun-key

# Ollama 本地（不需要key，随便填）
OLLAMA_API_KEY=local-no-key

# Groq (groq.com)
GROQ_API_KEY=your-groq-key